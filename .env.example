APP_ENV=development
LOG_LEVEL=INFO
LOG_TELEGRAM_MESSAGE_TEXT=false

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram/user

# Exactly one of the following must be set:
TELEGRAM_SOURCE_CHAT_ID=
TELEGRAM_SOURCE_USERNAME=

TELEGRAM_CATCH_UP_ENABLED=true
TELEGRAM_READY_MARKER_PATH=data/telegram/.ready

# Optional. Example: http://user:pass@host:port or socks5://user:pass@host:port
PROXY_URL=

# --- Trading / Bybit (default: disabled — parse/log only) ---
# disabled | demo | mainnet. demo = Bybit Demo Trading (api-demo.bybit.com), not testnet.
TRADING_MODE=disabled
ALLOW_MAINNET_TRADING=false

BYBIT_API_KEY=
BYBIT_API_SECRET=

BYBIT_CATEGORY=linear
BYBIT_SETTLE_COIN=USDT
BYBIT_LEVERAGE=5
BYBIT_EXPECTED_MARGIN_MODE=

TRADE_MARGIN_PCT=1.0
ORDER_SIZING_PRICE=lastPrice

TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=2.0
TAKE_PROFIT_TRIGGER_BY=LastPrice

STOP_LOSS_ENABLED=true
STOP_LOSS_PCT=3

MAX_SIGNAL_AGE_SECONDS=30
EXECUTE_EDITED_MESSAGES=false
EXISTING_POSITION_POLICY=skip

# Journal plus bot settings (table runtime_config) in this SQLite file.
EXECUTION_DB_PATH=data/trading/executions.sqlite3
ORDER_FILL_TIMEOUT_SEC=30

# Operator bot (Bot API). Empty token disables it.
# Admin user ids receive signal/order copies and may /set config.
# Config is stored in EXECUTION_DB_PATH (table runtime_config).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ADMIN_IDS=
